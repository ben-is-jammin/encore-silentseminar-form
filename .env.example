VITE_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id
VITE_N8N_WEBHOOK_USERNAME=your-basic-auth-username
VITE_N8N_WEBHOOK_PASSWORD=your-basic-auth-password
